---
import type { UnifiedAssignment } from '../schemas/assignment';
import { formatAssignmentDate } from '../lib/assignment-adapter';

interface Props {
  items: UnifiedAssignment[];
}

const { items = [] } = Astro.props;

// Resource rows (project gallery, piazza links) have no release/due dates
// and are shown in the bulletin instead.
const dated = items.filter((item) => item.releaseDate || item.dueDate);

function releaseDisplay(item: UnifiedAssignment): string | null {
  if (item.releaseDisplay) return item.releaseDisplay;
  if (item.releaseDate) return formatAssignmentDate(item.releaseDate);
  return null;
}
---

<section id="homework" aria-labelledby="homework-heading">
  <h2 id="homework-heading">Assignments</h2>

  <div class="table-responsive">
    <table class="content-table" aria-label="Course Assignments Schedule">
      <thead>
        <tr>
          <th scope="col" style="text-align: center; width: 15%;">Assignment</th>
          <th scope="col" style="text-align: center; width: 20%;">Release Date (EST)</th>
          <th scope="col" style="text-align: center; width: 30%;">Due Date (EST)</th>
          <th scope="col" style="text-align: center; width: 35%;">Related Materials / Links</th>
        </tr>
      </thead>
      <tbody>
        {dated.map((item) => (
          <tr>
            <td style="text-align: center; font-weight: 600;">{item.title}</td>
            <td style="text-align: center;">
              {releaseDisplay(item) ?? (<span>&mdash;</span>)}
            </td>
            <td style="text-align: center;">
              {item.dueDisplay ? (
                <span set:html={item.dueDisplay} />
              ) : item.deadlines.length > 1 ? (
                item.deadlines.map((d) => (
                  <div>
                    {d.label}: {d.display ?? formatAssignmentDate(d.date)}
                  </div>
                ))
              ) : item.dueDate ? (
                formatAssignmentDate(item.dueDate)
              ) : (
                <span>&mdash;</span>
              )}
            </td>
            <td>
              {item.links && item.links.length > 0 ? (
                <div style="display: flex; flex-direction: column; gap: 0.35rem;">
                  {item.links.map((mat) => (
                    <a
                      href={mat.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="table-link"
                    >
                      {mat.label}
                    </a>
                  ))}
                </div>
              ) : (
                <span style="color: var(--color-text-muted); font-style: italic;">
                  To be announced
                </span>
              )}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
