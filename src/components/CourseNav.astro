---
interface Props {
  currentSemester: string;
  allSemesters?: Array<{ id: string; title: string; isCurrent: boolean }>;
}

const { currentSemester, allSemesters = [] } = Astro.props;

const navItems = [
  { label: 'About', href: '#title' },
  { label: 'Events', href: '#events' },
  { label: 'OH', href: '#oh' },
  { label: 'Syllabus', href: '#syllabus' },
  { label: 'Lectures', href: '#lectures' },
  { label: 'Recitations & Bootcamps', href: '#recitations' },
  { label: 'Assignments', href: '#homework' },
  { label: 'Projects Page', href: '/shared/project.html' },
];

// Only keep at most 3 consecutive semesters around currentSemester
// config.yaml lists semesters in reverse chronological order: F26, S26, F25, S25, ...
const currentIndex = allSemesters.findIndex((s) => s.id === currentSemester);
let visibleSemesters = allSemesters;
if (allSemesters.length > 3) {
  if (currentIndex <= 0) {
    // Current is latest (e.g. F26): show [F26, S26, F25]
    visibleSemesters = allSemesters.slice(0, 3);
  } else if (currentIndex >= allSemesters.length - 1) {
    // Current is oldest: show last 3
    visibleSemesters = allSemesters.slice(-3);
  } else {
    // Current is in the middle: show [prev, current, next]
    visibleSemesters = allSemesters.slice(currentIndex - 1, currentIndex + 2);
  }
}
---

<header class="site-header" role="banner">
  <nav class="nav-menu" aria-label="Primary Navigation">
    {navItems.map((item) => (
      <a href={item.href} class="nav-link">
        {item.label}
      </a>
    ))}
  </nav>

  <div class="version-menu" aria-label="Semester Switcher">
    {visibleSemesters.map((s) =>
      s.id === currentSemester ? (
        <span class="version-current" aria-current="page">{s.id}</span>
      ) : (
        <a href={`../${s.id}/`} class="version-link">
          {s.id}
        </a>
      )
    )}
  </div>
</header>

<div class="mobile-header-bar">
  <button
    type="button"
    class="menu-toggle-btn"
    id="menu-open-btn"
    aria-expanded="false"
    aria-controls="mobile-drawer"
    aria-label="Open Navigation Menu"
  >
    Menu
  </button>
</div>

<div class="mobile-menu-backdrop" id="drawer-backdrop"></div>

<aside class="mobile-drawer" id="mobile-drawer" aria-hidden="true">
  <button
    type="button"
    class="mobile-drawer-close"
    id="menu-close-btn"
    aria-label="Close Navigation Menu"
  >
    &times;
  </button>

  <nav class="mobile-nav-list" aria-label="Mobile Primary Navigation">
    {navItems.map((item) => (
      <a href={item.href} class="mobile-nav-link">
        {item.label}
      </a>
    ))}
  </nav>

  <div class="mobile-version-menu" aria-label="Mobile Semester Switcher">
    {visibleSemesters.map((s) =>
      s.id === currentSemester ? (
        <span class="version-current" aria-current="page">{s.id}</span>
      ) : (
        <a href={`../${s.id}/`} class="version-link">
          {s.id}
        </a>
      )
    )}
  </div>
</aside>

<script>
  // Ultra-lightweight Vanilla JS for Mobile Navigation Drawer (0 KB external libraries)
  const openBtn = document.getElementById('menu-open-btn');
  const closeBtn = document.getElementById('menu-close-btn');
  const drawer = document.getElementById('mobile-drawer');
  const backdrop = document.getElementById('drawer-backdrop');

  function openMenu() {
    drawer?.classList.add('open');
    backdrop?.classList.add('open');
    drawer?.setAttribute('aria-hidden', 'false');
    openBtn?.setAttribute('aria-expanded', 'true');
  }

  function closeMenu() {
    drawer?.classList.remove('open');
    backdrop?.classList.remove('open');
    drawer?.setAttribute('aria-hidden', 'true');
    openBtn?.setAttribute('aria-expanded', 'false');
  }

  openBtn?.addEventListener('click', openMenu);
  closeBtn?.addEventListener('click', closeMenu);
  backdrop?.addEventListener('click', closeMenu);

  // Close drawer on internal link clicks
  drawer?.querySelectorAll('.mobile-nav-link').forEach((link) => {
    link.addEventListener('click', closeMenu);
  });
</script>
