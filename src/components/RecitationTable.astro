---
import type { RecitationsData, RecitationEntry } from '../schemas/recitation';
import RecitationLinks from './RecitationLinks.astro';

interface Props {
  recitationsData?: RecitationsData;
}

const { recitationsData = { recitations_0: [], recitations: [] } } = Astro.props;
const recitations_0 = recitationsData.recitations_0;
const recitations = recitationsData.recitations;

function isSession(entry: RecitationEntry): entry is Extract<RecitationEntry, { title: string }> {
  return 'title' in entry;
}
---

<section id="recitations" aria-labelledby="recitations-heading">
  <h2 id="recitations-heading">Recitations/Labs & Bootcamps</h2>

  <div class="table-responsive">
    <table class="content-table">
      <thead>
        <tr>
          <th scope="col" style="text-align: center; width: 8%;">Recitation</th>
          <th scope="col" style="text-align: center; width: 12%;">Date</th>
          <th scope="col" style="text-align: center; width: 15%;">Group</th>
          <th scope="col" style="text-align: center; width: 25%;">Topics</th>
          <th scope="col" style="text-align: center; width: 15%;">Materials</th>
          <th scope="col" style="text-align: center; width: 15%;">YouTube Videos</th>
          <th scope="col" style="text-align: center; width: 10%;">Instructor</th>
        </tr>
      </thead>
      <tbody>
        {/* Recitation 0 Block */}
        {recitations_0.map((recitationDay) => (
          recitationDay.groups?.map((group) => (
            group.topics?.map((topic, topicIdx) => (
              <tr>
                <td style="text-align: center; font-weight: 600;">{topic.id}</td>
                <td>{topic.date || (topicIdx === 0 ? recitationDay.date : '')}</td>
                {topicIdx === 0 && (
                  <td
                    rowspan={group.topics.length}
                    style="vertical-align: middle; font-weight: 600;"
                  >
                    {group.name}
                  </td>
                )}
                <td>{topic.title}</td>
                <td>
                  <RecitationLinks links={topic.materials} />
                </td>
                <td>
                  {topic.videos && topic.videos.length > 0 ? (
                    <RecitationLinks links={topic.videos} />
                  ) : (
                    <span style="color: var(--color-text-muted); font-style: italic;">Coming Soon</span>
                  )}
                </td>
                <td>{topic.authors}</td>
              </tr>
            ))
          ))
        ))}

        {/* Regular Recitations Block */}
        {recitations.map((entry) => (
          isSession(entry) ? (
            <tr>
              <td style="font-weight: 600;">{entry.title}</td>
              <td set:html={entry.date} />
              <td></td>
              <td>
                {Array.isArray(entry.topics) ? (
                  <ul style="padding-left: 1.2rem; margin: 0;">
                    {entry.topics.map((t: string) => (
                      <li>{t}</li>
                    ))}
                  </ul>
                ) : (
                  entry.topics || ''
                )}
              </td>
              <td>
                <RecitationLinks links={entry.materials} />
              </td>
              <td>
                <RecitationLinks links={entry.videos} />
              </td>
              <td>{entry.authors}</td>
            </tr>
          ) : (
            <tr>
              <td style="font-weight: 600;">{entry.number}</td>
              <td set:html={entry.date} />
              <td></td>
              <td>
                <ul style="padding-left: 1.2rem; margin: 0;">
                  {entry.topics.map((t: string) => (
                    <li>{t}</li>
                  ))}
                </ul>
              </td>
              <td>
                <RecitationLinks links={[...entry.slides_videos, ...entry.notes_code]} />
              </td>
              <td></td>
              <td></td>
            </tr>
          )
        ))}
      </tbody>
    </table>
  </div>
</section>
