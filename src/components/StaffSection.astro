---
import type { StaffData, StaffMember } from '../schemas/staff';

interface Props {
  staffData?: StaffData;
}

const { staffData = {} } = Astro.props;

function getInitials(name: string): string {
  return name
    .split(' ')
    .filter(Boolean)
    .map((part) => part[0])
    .join('')
    .substring(0, 2)
    .toUpperCase();
}

const allStaff: Array<{ role: string; person: StaffMember }> = [];

if (staffData.instructors) {
  for (const person of staffData.instructors) {
    allStaff.push({ role: 'Instructor', person });
  }
}
if (staffData.shadowInstructors) {
  for (const person of staffData.shadowInstructors) {
    allStaff.push({ role: 'Shadow Instructor', person });
  }
}
if (staffData.headTAs) {
  for (const person of staffData.headTAs) {
    allStaff.push({ role: 'Head TA', person });
  }
}
if (staffData.coreTAs) {
  for (const person of staffData.coreTAs) {
    allStaff.push({ role: 'TA', person });
  }
}
---

<section id="oh" aria-labelledby="staff-heading">
  <h2 id="staff-heading">Course Staff</h2>

  <div class="head-people">
    {allStaff.map(({ role, person }) => (
      <div class="person">
        <div class="person-thumbnail">
          <div class="person-avatar">
            {person.avatar ? (
              <span class="person-image" style={`background-image: url('${person.avatar}');`}></span>
            ) : (
              <span class="person-avatar-placeholder">{getInitials(person.name)}</span>
            )}
          </div>
        </div>
        <div class="person-text">
          <h3 class="person-name">
            <span class="person-role-label">{role}</span>{' '}
            {person.website ? (
              <a href={person.website} target="_blank" rel="noopener noreferrer">
                <b>{person.name}</b>
              </a>
            ) : (
              <a href={`mailto:${person.email}`}>
                <b>{person.name}</b>
              </a>
            )}
          </h3>
          <p class="person-email">
            <a href={`mailto:${person.email}`}>{person.email}</a>
          </p>
          {person.officeHours && <p class="person-oh">OH: {person.officeHours}</p>}
        </div>
      </div>
    ))}
  </div>

  {staffData.images && staffData.images.length > 0 && (
    <div class="staff-photos">
      {staffData.images.map((img) => (
        <figure class="staff-photo-card">
          <img src={img.src} alt={img.alt} class="staff-photo" loading="lazy" />
          <figcaption class="staff-photo-caption">{img.caption}</figcaption>
        </figure>
      ))}
    </div>
  )}

  {staffData.pastTAsUrl && (
    <div class="acknowledgments-box">
      <h3>Acknowledgments</h3>
      <p>
        <a href={staffData.pastTAsUrl} target="_blank" rel="noopener noreferrer">
          Past TA Acknowledgments &#8599;
        </a>{' '}
        - Check out our dedicated TA Hall of Fame across previous semesters!
      </p>
    </div>
  )}
</section>

<style>
  /* head-people and person styling with Lato / Avenir fallback typography */
  .head-people {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: 20px;
    margin-top: var(--space-md);
    margin-bottom: var(--space-xl);
  }

  .head-people .person {
    flex: 0 0 calc(33.333% - 14px);
    max-width: calc(33.333% - 14px);
    box-sizing: border-box;
    display: flex;
    align-items: center;
    padding: 0;
  }

  @media (max-width: 991px) {
    .head-people .person {
      flex: 0 0 calc(50% - 10px);
      max-width: calc(50% - 10px);
    }
  }

  @media (max-width: 575px) {
    .head-people .person {
      flex: 0 0 100%;
      max-width: 100%;
    }
  }

  .person-thumbnail {
    width: 7em;
    flex-shrink: 0;
  }

  .person-thumbnail .person-avatar {
    overflow: hidden;
    border-radius: 50%;
    height: 6em;
    width: 6em;
    margin: 0.5em 1.5em 0.5em 0;
    background: var(--surface-container-low, #f6f3f2);
    border: 1px solid var(--surface-border, #e5e5e5);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .person-thumbnail .person-image {
    height: 100%;
    width: 100%;
    display: inline-block;
    background-size: cover;
    background-position: center;
  }

  .person-avatar-placeholder {
    font-size: 1.4em;
    font-weight: 700;
    color: #888888;
    letter-spacing: 0.04em;
    font-family: 'Avenir', 'Lato', var(--font-family-base);
  }

  .person-text {
    width: calc(100% - 7em);
  }

  .person-name {
    font-size: 1.2em;
    font-family: 'Avenir', 'Lato', sans-serif;
    color: #888;
    font-weight: 300;
    margin-bottom: 0.25em;
    line-height: 1.3em;
  }

  .person-name span {
    color: #000;
  }

  .person-name a {
    border-bottom: 1px dotted #000;
    color: #000;
    font-weight: inherit;
    text-decoration: none;
    transition: border-bottom-color 0.15s ease, color 0.15s ease;
  }

  .person-name a:hover {
    border-bottom: 1px solid #000;
    text-decoration: none;
    color: #000;
  }

  .person-text p {
    color: #888;
    font-size: 1.1em;
    margin: 0.1em 0;
    line-height: 1.3;
  }

  .person-text p span,
  .person-text p a {
    color: #000;
  }

  .person-text p a:hover {
    color: #f09228;
    text-decoration: none;
  }

  .person-role-label {
    color: #888888;
    font-weight: 300;
  }

  /* Staff photos */
  .staff-photos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: var(--space-md);
    margin-top: var(--space-xl);
  }

  .staff-photo-card {
    background: var(--surface-page);
    border: 1px solid var(--surface-border);
    border-radius: var(--rounded-default);
    overflow: hidden;
    margin: 0;
    box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
  }

  .staff-photo {
    width: 100%;
    height: auto;
    display: block;
  }

  .staff-photo-caption {
    padding: 8px 12px;
    font-size: var(--body-sm-size);
    color: var(--text-muted);
    text-align: center;
    background: var(--surface-subtle);
  }

  .acknowledgments-box {
    margin-top: var(--space-xl);
    background: var(--surface-subtle);
    border: 1px solid var(--surface-border);
    border-radius: var(--rounded-default);
    padding: var(--space-md) var(--space-lg);
  }

  .acknowledgments-box h3 {
    margin: 0 0 var(--space-xs) 0;
    font-size: var(--body-md-size);
    color: var(--color-heading-h2);
  }

  .acknowledgments-box p {
    margin: 0;
    font-size: var(--body-sm-size);
  }
</style>
