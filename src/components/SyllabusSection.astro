---
import type { SyllabusData } from '../schemas/syllabus';

interface Props {
  syllabusData?: SyllabusData;
}

const { syllabusData } = Astro.props;
---

<section id="syllabus" aria-labelledby="syllabus-heading">
  <h2 id="syllabus-heading">Syllabus &amp; Course Policies</h2>

  {syllabusData && syllabusData.policies.length > 0 ? (
    <div class="table-responsive" style="margin-bottom: 3rem;">
      <table class="content-table" aria-label="Course Policies Breakdown">
        <thead>
          <tr>
            <th scope="col" style="width: 25%;">Category</th>
            <th scope="col" style="width: 75%;">Policy Details</th>
          </tr>
        </thead>
        <tbody>
          {syllabusData.policies.map((item) => (
            <tr>
              <td><strong>{item.category}</strong></td>
              <td>
                {item.details}
                {item.subItems && item.subItems.length > 0 && (
                  <ul style="margin-top: 0.5rem; margin-bottom: 0.25rem;">
                    {item.subItems.map((sub) => (
                      <li>{sub}</li>
                    ))}
                  </ul>
                )}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ) : (
    <p class="content-unavailable">
      Syllabus and course policy information is not available for this semester.
    </p>
  )}

  <h2>Resources</h2>

  <div style="margin-bottom: 2rem;">
    {syllabusData && syllabusData.resources.length > 0 ? (
      syllabusData.resources.map((res) => (
        <div style="margin-bottom: 1.5rem;">
          <h3>
            {res.title}
            {res.badge && (
              <span style="background: var(--cmu-red); color: white; padding: 2px 6px; font-size: 0.75rem; border-radius: 4px; font-weight: bold; margin-left: 0.5rem;">
                {res.badge}
              </span>
            )}
          </h3>
          <p>{res.description}</p>
          {res.links && res.links.length > 0 && (
            <ul style="margin-top: 0.25rem; margin-bottom: 0.5rem;">
              {res.links.map((link) => (
                <li>
                  <a href={link.url} target="_blank" rel="noopener noreferrer">
                    <strong>{link.label}</strong>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      ))
    ) : (
      <p class="content-unavailable">
        Resource information is not available for this semester.
      </p>
    )}
  </div>
</section>
