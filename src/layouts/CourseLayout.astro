---
import CourseNav from '../components/CourseNav.astro';
import SponsorLockup from '../components/SponsorLockup.astro';
import type { Semester } from '../schemas/semester';
import '../styles/main.css';

interface Props {
  semester: Semester;
  allSemesters?: Array<{ id: string; title: string; isCurrent: boolean }>;
}

const { semester, allSemesters = [] } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{semester.courseNumber}: {semester.title} ({semester.term})</title>
    <link rel="shortcut icon" href="./images/favicon.ico" type="image/x-icon" />

    <!-- Typography: Open Sans & Lato -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Lato:ital,wght@0,300;0,400;0,700;1,300;1,400;1,700&family=Open+Sans:ital,wght@0,300;0,400;0,600;0,700;1,300;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to main content</a>

    <CourseNav currentSemester={semester.id} allSemesters={allSemesters} />

    <header class="titlebar container" id="title">
      <p class="hero-eyebrow">Carnegie Mellon University</p>
      <h1 class="course-title">
        <b>{semester.courseNumber}</b> {semester.title}
      </h1>
      <div class="course-subtitle">
        <i>{semester.term}</i>
      </div>
      {semester.zoomLink && (
        <div>
          <a
            href={semester.zoomLink}
            class="zoom-badge"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Class Streaming Link on Zoom"
          >
            Class Streaming Link &#8599;
          </a>
        </div>
      )}
      {semester.venue && (
        <p class="venue-info">In-Person Venue: {semester.venue}</p>
      )}
      {semester.supportedBy && (
        <SponsorLockup supportedBy={semester.supportedBy} />
      )}
    </header>

    <main id="main-content" class="container" role="main">
      <slot />
    </main>

    <button id="scroll-to-top" class="scroll-to-top" type="button" aria-label="Scroll to top of page" title="Back to top">
      <span class="hippo-mascot" aria-hidden="true">
        <svg viewBox="0 0 36 36" fill="none" xmlns="http://www.w3.org/2000/svg" class="hippo-svg">
          <!-- Hippo ears -->
          <circle cx="8" cy="8" r="4" fill="#a80000" stroke="#ffffff" stroke-width="1.5" />
          <circle cx="8" cy="8" r="2" fill="#ffb3ad" />
          <circle cx="28" cy="8" r="4" fill="#a80000" stroke="#ffffff" stroke-width="1.5" />
          <circle cx="28" cy="8" r="2" fill="#ffb3ad" />
          <!-- Hippo head -->
          <ellipse cx="18" cy="16" rx="13" ry="11" fill="#a80000" stroke="#ffffff" stroke-width="1.5" />
          <!-- Eyes -->
          <circle cx="13" cy="14" r="2" fill="#ffffff" />
          <circle cx="13.5" cy="14" r="1.2" fill="#1b1c1c" />
          <circle cx="23" cy="14" r="2" fill="#ffffff" />
          <circle cx="22.5" cy="14" r="1.2" fill="#1b1c1c" />
          <!-- Snout / Muzzle -->
          <ellipse cx="18" cy="24" rx="10" ry="7.5" fill="#c58682" stroke="#ffffff" stroke-width="1.5" />
          <!-- Nostrils -->
          <ellipse cx="14" cy="23" rx="1.5" ry="2" fill="#6a020a" />
          <ellipse cx="22" cy="23" rx="1.5" ry="2" fill="#6a020a" />
          <!-- Friendly smile -->
          <path d="M15 27 Q18 29.5 21 27" stroke="#6a020a" stroke-width="1.2" stroke-linecap="round" fill="none" />
        </svg>
      </span>
      <span class="scroll-arrow">&#8679;</span>
    </button>

    <footer class="site-footer" role="contentinfo">
      <p class="footer-title">
        {semester.courseNumber} {semester.title} |{' '}
        <span style="white-space: nowrap;">Carnegie Mellon University</span>
      </p>
    </footer>

    <script>
      const scrollBtn = document.getElementById('scroll-to-top');
      window.addEventListener('scroll', () => {
        if (window.scrollY > 400) {
          scrollBtn?.classList.add('visible');
        } else {
          scrollBtn?.classList.remove('visible');
        }
      });
      scrollBtn?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
    </script>
  </body>
</html>
